#!/bin/sh
# Duke Nukem 3D with the Polymost renderer (OpenGL on the GS and VU1).
# The settings are separate from the software version: the renderer needs
# 32 bits for each pixel, the software version needs 8.
GAMES="${HOME:-/home/root}/games"
HOME=/home/root/duke3d-gl
export HOME
mkdir -p "$HOME"
mkdir -p "$HOME/.jfduke3d"
if [ ! -f "$HOME/.jfduke3d/duke3d.cfg" ]; then
    cp /usr/share/games/jfduke3d-polymost/duke3d.cfg "$HOME/.jfduke3d/duke3d.cfg"
fi
# The game searches the settings directory for its data file, so a link
# there points to the file. The places, in order: ~/games/duke3d, the
# hard disk (/data), the FAT partition (/boot).
GRP=""
for f in "$GAMES/duke3d/DUKE3D.GRP" "$GAMES/duke3d/duke3d.grp" \
         /data/DUKE3D.GRP /data/duke3d.grp /boot/DUKE3D.GRP; do
    if [ -f "$f" ]; then
        GRP=$f
        break
    fi
done
if [ -z "$GRP" ]; then
    echo "duke3d-gl: no DUKE3D.GRP. Put it in $GAMES/duke3d/" >&2
    exit 1
fi
ln -sf "$GRP" "$HOME/.jfduke3d/duke3d.grp"
exec /usr/libexec/jfduke3d-polymost/duke3d "$@"
