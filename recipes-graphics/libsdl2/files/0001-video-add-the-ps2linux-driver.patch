From: Andrea Campanella <emuboy85@gmail.com>
Subject: [PATCH] video: add the ps2linux driver for Linux on the PlayStation 2

A window is a picture in RAM. To show it, the driver sends the picture to
the Graphics Synthesizer as a texture and draws one textured rectangle that
fills the screen. Input comes from the SDL evdev code.

A window with the OpenGL flag uses libGL.so.1 (ps2gl). The driver loads the
library, gives its functions to the program and calls its context functions.

Upstream-Status: Inappropriate [needs the direct hardware access of the meta-playstation2 layer]

---
diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -424,6 +424,7 @@
 set_option(SDL_DIRECTFB            "Use DirectFB video driver" OFF)
 dep_option(SDL_DIRECTFB_SHARED     "Dynamically load directfb support" ON "SDL_DIRECTFB" OFF)
 set_option(SDL_DUMMYVIDEO          "Use dummy video driver" ON)
+set_option(SDL_PS2LINUX            "Use the video driver for Linux on the PlayStation 2" OFF)
 dep_option(SDL_IBUS                "Enable IBus support" ON ${UNIX_SYS} OFF)
 set_option(SDL_SYSTEM_ICONV        "Use iconv() from system-installed libraries" ${SDL_SYSTEM_ICONV_DEFAULT})
 set_option(SDL_LIBICONV            "Prefer iconv() from libiconv, if available, over libc version" OFF)
@@ -1246,6 +1247,17 @@
 endif()
 
 if(SDL_VIDEO)
+  if(SDL_PS2LINUX)
+    set(SDL_VIDEO_DRIVER_PS2LINUX 1)
+    file(GLOB VIDEO_PS2LINUX_SOURCES ${SDL2_SOURCE_DIR}/src/video/ps2linux/*.c)
+    list(APPEND SOURCE_FILES ${VIDEO_PS2LINUX_SOURCES})
+    set(HAVE_PS2LINUX TRUE)
+    set(HAVE_SDL_VIDEO TRUE)
+    # The driver gives OpenGL windows through libGL.so.1. SDL_config.h then
+    # says SDL_VIDEO_OPENGL, which programs test before they ask for one.
+    set(SDL_VIDEO_OPENGL 1)
+    set(HAVE_OPENGL TRUE)
+  endif()
   if(SDL_DUMMYVIDEO)
     set(SDL_VIDEO_DRIVER_DUMMY 1)
     file(GLOB VIDEO_DUMMY_SOURCES ${SDL2_SOURCE_DIR}/src/video/dummy/*.c)
