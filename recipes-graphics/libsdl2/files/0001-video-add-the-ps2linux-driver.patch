diff --git a/src/video/ps2linux/SDL_ps2linuxvideo.c b/src/video/ps2linux/SDL_ps2linuxvideo.c
--- a/src/video/ps2linux/SDL_ps2linuxvideo.c
+++ b/src/video/ps2linux/SDL_ps2linuxvideo.c
@@ -0,0 +1,906 @@
