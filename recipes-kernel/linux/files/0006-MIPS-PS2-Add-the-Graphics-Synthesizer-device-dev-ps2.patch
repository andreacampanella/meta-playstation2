diff --git a/drivers/ps2/gs-dev.c b/drivers/ps2/gs-dev.c
new file mode 100644
index 000000000..622c116e4
--- /dev/null
+++ b/drivers/ps2/gs-dev.c
@@ -0,0 +1,612 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * PlayStation 2 Graphics Synthesizer device for programs: /dev/ps2gs
+ *
+ * Programs map a packet buffer and the driver sends the packets to the GIF
+ * (GS) or the VIF1 (vector unit 1) with the DMA controller. The driver also
+ * waits for the vertical sync and gives access to the display registers.
+ *
+ * Copyright (C) 2026 Andrea Campanella
+ *
+ * The design follows the ps2gs and ps2dma drivers of the Sony PlayStation 2
+ * Linux kit (Copyright (C) 2000-2002 Sony Computer Entertainment Inc.), with
+ * new code for Linux 5.4 and the frno7 kernel fork.
+ */
+
+#include <linux/atomic.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/miscdevice.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+
+#include <asm/io.h>
+#include <asm/page.h>
+
+#include <asm/mach-ps2/dmac.h>
+#include <asm/mach-ps2/gif.h>
+#include <asm/mach-ps2/gs-registers.h>
+#include <asm/mach-ps2/irq.h>
+
+#include <uapi/linux/ps2gs.h>
+
+#define PS2GS_VERSION		1
+
+#define VIF1_STAT		0x10003c00
+#define VIF1_FBRST		0x10003c10
+#define VIF1_STAT_BUSY		0x1f00000f	/* FQC, VGW, VEW, VPS */
+
+#define PS2GS_DMA_TIMEOUT	(HZ)		/* One second for one packet */
+#define PS2GS_VSYNC_TIMEOUT	(HZ / 10)	/* Two fields at 50 Hz */
+#define PS2GS_QWC_MAX		0xffff		/* The QWC register has 16 bits */
+
+struct ps2gs_channel {
+	const char *name;
+	u32 chcr;
+	u32 madr;
+	u32 qwc;
+	unsigned int irq;
+	bool done;	/* Set by the interrupt */
+};
+
+static struct {
+	struct mutex lock;		/* One program sends at a time */
+	wait_queue_head_t wq;
+	struct ps2gs_channel channel[2];
+	atomic_t vsync_count;
+	atomic_t users;
+	bool vsync_irq_ok;
+} ps2gs = {
+	.channel = {
+		[PS2GS_CHANNEL_GIF] = {
+			.name = "GIF",
+			.chcr = DMAC_GIF_CHCR,
+			.madr = DMAC_GIF_MADR,
+			.qwc  = DMAC_GIF_QWC,
+			.irq  = IRQ_DMAC_GIF,
+		},
+		[PS2GS_CHANNEL_VIF1] = {
+			.name = "VIF1",
+			.chcr = DMAC_VIF1_CHCR,
+			.madr = DMAC_VIF1_MADR,
+			.qwc  = DMAC_VIF1_QWC,
+			.irq  = IRQ_DMAC_VIF1,
+		},
+	},
+};
+
+struct ps2gs_file {
+	struct page *pages;
+	unsigned int order;
+	void *virt;
+	size_t size;
+
+	/* Display registers at open, restored at release. */
+	bool saved_pmode, saved_dispfb1, saved_dispfb2;
+	bool saved_display1, saved_display2;
+	u64 pmode, dispfb1, dispfb2, display1, display2;
+};
+
+/* --- DMA channels ----------------------------------------------------- */
+
+static bool channel_busy(const struct ps2gs_channel *ch)
+{
+	return (inl(ch->chcr) & DMAC_CHCR_BUSY) != 0;
+}
+
+static irqreturn_t ps2gs_dma_irq(int irq, void *data)
+{
+	struct ps2gs_channel *ch = data;
+
+	ch->done = true;
+	wake_up_all(&ps2gs.wq);
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * Wait until the channel is idle. The interrupt wakes the wait. If the
+ * interrupt does not come, the short timeout polls the channel register.
+ */
+static int channel_wait(struct ps2gs_channel *ch)
+{
+	const unsigned long deadline = jiffies + PS2GS_DMA_TIMEOUT;
+
+	while (channel_busy(ch)) {
+		if (time_after(jiffies, deadline))
+			return -ETIMEDOUT;
+		wait_event_timeout(ps2gs.wq, ch->done || !channel_busy(ch),
+			msecs_to_jiffies(4));
+	}
+
+	return 0;
+}
+
+static void channel_reset(struct ps2gs_channel *ch)
+{
+	outl(0, ch->chcr);	/* Stop the channel */
+	if (ch == &ps2gs.channel[PS2GS_CHANNEL_GIF]) {
+		gif_reset();
+	} else {
+		outl(1, VIF1_FBRST);	/* Reset the VIF1 */
+		udelay(100);
+	}
+	ch->done = false;
+}
+
+static bool vu1_busy(void)
+{
+	return (inl(VIF1_STAT) & VIF1_STAT_BUSY) != 0;
+}
+
+static int vu1_wait(void)
+{
+	const unsigned long deadline = jiffies + PS2GS_DMA_TIMEOUT;
+
+	while (vu1_busy()) {
+		if (time_after(jiffies, deadline))
+			return -ETIMEDOUT;
+		usleep_range(50, 200);
+	}
+
+	return 0;
+}
+
+/* --- Vertical sync ---------------------------------------------------- */
+
+static irqreturn_t ps2gs_vsync_irq(int irq, void *data)
+{
+	atomic_inc(&ps2gs.vsync_count);
+	wake_up_all(&ps2gs.wq);
+
+	return IRQ_HANDLED;
+}
+
+static int csr_field(void)
+{
+	return gs_read_csr().field;
+}
+
+/*
+ * Wait for the next vertical sync. The GS interrupt is the first choice.
+ * If it does not come, the driver polls the FIELD bit of the CSR register,
+ * which changes with each field, and uses polling from then on.
+ */
+static int ps2gs_vsync_wait(void)
+{
+	const int count = atomic_read(&ps2gs.vsync_count);
+	const int field = csr_field();
+	unsigned long deadline;
+	long left;
+
+	if (ps2gs.vsync_irq_ok) {
+		left = wait_event_interruptible_timeout(ps2gs.wq,
+			atomic_read(&ps2gs.vsync_count) != count,
+			PS2GS_VSYNC_TIMEOUT);
+		if (left > 0)
+			return csr_field();
+		if (left < 0)
+			return left;	/* Signal */
+		pr_warn("ps2gs: no vertical sync interrupt, polling the CSR\n");
+		ps2gs.vsync_irq_ok = false;
+	}
+
+	deadline = jiffies + PS2GS_VSYNC_TIMEOUT;
+	while (csr_field() == field) {
+		if (time_after(jiffies, deadline))
+			return -ETIMEDOUT;
+		if (signal_pending(current))
+			return -ERESTARTSYS;
+		usleep_range(200, 500);
+	}
+
+	return csr_field();
+}
+
+/* --- Privileged registers --------------------------------------------- */
+
+static int ps2gs_get_reg(u32 reg, u64 *value)
+{
+	switch (reg) {
+	case PS2GS_REG_PMODE:
+		if (!gs_valid_pmode())
+			return -ENODATA;
+		*value = gs_readq_pmode();
+		return 0;
+	case PS2GS_REG_DISPFB1:
+		if (!gs_valid_dispfb1())
+			return -ENODATA;
+		*value = gs_readq_dispfb1();
+		return 0;
+	case PS2GS_REG_DISPLAY1:
+		if (!gs_valid_display1())
+			return -ENODATA;
+		*value = gs_readq_display1();
+		return 0;
+	case PS2GS_REG_DISPFB2:
+		if (!gs_valid_dispfb2())
+			return -ENODATA;
+		*value = gs_readq_dispfb2();
+		return 0;
+	case PS2GS_REG_DISPLAY2:
+		if (!gs_valid_display2())
+			return -ENODATA;
+		*value = gs_readq_display2();
+		return 0;
+	case PS2GS_REG_BGCOLOR:
+		if (!gs_valid_bgcolor())
+			return -ENODATA;
+		*value = gs_readq_bgcolor();
+		return 0;
+	case PS2GS_REG_CSR:
+		*value = gs_readq_csr();
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int ps2gs_set_reg(u32 reg, u64 value)
+{
+	switch (reg) {
+	case PS2GS_REG_PMODE:
+		gs_writeq_pmode(value);
+		return 0;
+	case PS2GS_REG_DISPFB1:
+		gs_writeq_dispfb1(value);
+		return 0;
+	case PS2GS_REG_DISPLAY1:
+		gs_writeq_display1(value);
+		return 0;
+	case PS2GS_REG_DISPFB2:
+		gs_writeq_dispfb2(value);
+		return 0;
+	case PS2GS_REG_DISPLAY2:
+		gs_writeq_display2(value);
+		return 0;
+	case PS2GS_REG_BGCOLOR:
+		gs_writeq_bgcolor(value);
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static void ps2gs_save_display(struct ps2gs_file *f)
+{
+	f->saved_pmode = !ps2gs_get_reg(PS2GS_REG_PMODE, &f->pmode);
+	f->saved_dispfb1 = !ps2gs_get_reg(PS2GS_REG_DISPFB1, &f->dispfb1);
+	f->saved_display1 = !ps2gs_get_reg(PS2GS_REG_DISPLAY1, &f->display1);
+	f->saved_dispfb2 = !ps2gs_get_reg(PS2GS_REG_DISPFB2, &f->dispfb2);
+	f->saved_display2 = !ps2gs_get_reg(PS2GS_REG_DISPLAY2, &f->display2);
+}
+
+static void ps2gs_restore_display(const struct ps2gs_file *f)
+{
+	if (f->saved_dispfb1)
+		gs_writeq_dispfb1(f->dispfb1);
+	if (f->saved_display1)
+		gs_writeq_display1(f->display1);
+	if (f->saved_dispfb2)
+		gs_writeq_dispfb2(f->dispfb2);
+	if (f->saved_display2)
+		gs_writeq_display2(f->display2);
+	if (f->saved_pmode)
+		gs_writeq_pmode(f->pmode);
+}
+
+/* --- Packet buffer ---------------------------------------------------- */
+
+static int ps2gs_send(struct ps2gs_file *f, const struct ps2gs_send *s)
+{
+	struct ps2gs_channel *ch;
+	size_t len, left;
+	u32 offset;
+	int err = 0;
+
+	if (s->channel > PS2GS_CHANNEL_VIF1)
+		return -EINVAL;
+	if (s->flags & ~PS2GS_SEND_WAIT)
+		return -EINVAL;
+	if (!f->virt)
+		return -ENXIO;	/* No buffer mapped */
+	if (!s->qwc)
+		return 0;
+	if (s->offset & 15)
+		return -EINVAL;
+	len = (size_t)s->qwc * 16;
+	if (s->offset > f->size || len > f->size - s->offset)
+		return -EINVAL;
+
+	ch = &ps2gs.channel[s->channel];
+
+	dma_cache_wback((unsigned long)f->virt + s->offset, len);
+
+	mutex_lock(&ps2gs.lock);
+
+	/* Wait for the previous packet on this channel. */
+	err = channel_wait(ch);
+	if (err) {
+		pr_warn("ps2gs: %s DMA did not end, reset\n", ch->name);
+		channel_reset(ch);
+		goto out;
+	}
+
+	offset = s->offset;
+	left = s->qwc;
+	while (left) {
+		const u32 qwc = min_t(size_t, left, PS2GS_QWC_MAX);
+
+		ch->done = false;
+		outl(virt_to_phys(f->virt + offset), ch->madr);
+		outl(qwc, ch->qwc);
+		wmb();
+		outl(DMAC_CHCR_SENDN, ch->chcr);
+
+		offset += qwc * 16;
+		left -= qwc;
+
+		if (left || (s->flags & PS2GS_SEND_WAIT)) {
+			err = channel_wait(ch);
+			if (err) {
+				pr_warn("ps2gs: %s DMA timeout, reset\n",
+					ch->name);
+				channel_reset(ch);
+				break;
+			}
+		}
+	}
+
+out:
+	mutex_unlock(&ps2gs.lock);
+	return err;
+}
+
+static int ps2gs_wait(unsigned long flags)
+{
+	int err = 0;
+
+	if (flags & ~(PS2GS_WAIT_GIF | PS2GS_WAIT_VIF1 | PS2GS_WAIT_VU1))
+		return -EINVAL;
+
+	mutex_lock(&ps2gs.lock);
+	if (flags & PS2GS_WAIT_GIF)
+		err = channel_wait(&ps2gs.channel[PS2GS_CHANNEL_GIF]);
+	if (!err && (flags & (PS2GS_WAIT_VIF1 | PS2GS_WAIT_VU1)))
+		err = channel_wait(&ps2gs.channel[PS2GS_CHANNEL_VIF1]);
+	if (!err && (flags & PS2GS_WAIT_VU1))
+		err = vu1_wait();
+	mutex_unlock(&ps2gs.lock);
+
+	return err;
+}
+
+static void ps2gs_reset_all(void)
+{
+	mutex_lock(&ps2gs.lock);
+	channel_reset(&ps2gs.channel[PS2GS_CHANNEL_VIF1]);
+	channel_reset(&ps2gs.channel[PS2GS_CHANNEL_GIF]);
+	mutex_unlock(&ps2gs.lock);
+}
+
+/* --- File operations -------------------------------------------------- */
+
+static int ps2gs_open(struct inode *inode, struct file *file)
+{
+	struct ps2gs_file *f;
+
+	if (atomic_cmpxchg(&ps2gs.users, 0, 1) != 0)
+		return -EBUSY;	/* One program at a time */
+
+	f = kzalloc(sizeof(*f), GFP_KERNEL);
+	if (!f) {
+		atomic_set(&ps2gs.users, 0);
+		return -ENOMEM;
+	}
+
+	ps2gs_save_display(f);
+	file->private_data = f;
+
+	return nonseekable_open(inode, file);
+}
+
+static int ps2gs_release(struct inode *inode, struct file *file)
+{
+	struct ps2gs_file *f = file->private_data;
+
+	/* Let the hardware finish, then put it in a known state. */
+	if (ps2gs_wait(PS2GS_WAIT_GIF | PS2GS_WAIT_VU1))
+		ps2gs_reset_all();
+	ps2gs_restore_display(f);
+
+	if (f->pages)
+		__free_pages(f->pages, f->order);
+	kfree(f);
+
+	atomic_set(&ps2gs.users, 0);
+
+	return 0;
+}
+
+static int ps2gs_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	struct ps2gs_file *f = file->private_data;
+	const size_t size = vma->vm_end - vma->vm_start;
+	unsigned int order;
+	struct page *pages;
+	int err;
+
+	if (vma->vm_pgoff || !size || size > PS2GS_MAX_BUFFER)
+		return -EINVAL;
+	if (f->virt)
+		return -EBUSY;	/* One buffer for each open */
+
+	order = get_order(size);
+	pages = alloc_pages(GFP_KERNEL | __GFP_ZERO, order);
+	if (!pages)
+		return -ENOMEM;
+
+	vma->vm_flags |= VM_IO | VM_DONTEXPAND | VM_DONTDUMP;
+	err = remap_pfn_range(vma, vma->vm_start, page_to_pfn(pages),
+		size, vma->vm_page_prot);
+	if (err) {
+		__free_pages(pages, order);
+		return err;
+	}
+
+	f->pages = pages;
+	f->order = order;
+	f->virt = page_address(pages);
+	f->size = size;
+
+	return 0;
+}
+
+static long ps2gs_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct ps2gs_file *f = file->private_data;
+	void __user *uarg = (void __user *)arg;
+	struct ps2gs_send s;
+	struct ps2gs_reg r;
+	struct ps2gs_info info;
+	int err;
+
+	switch (cmd) {
+	case PS2GS_IOC_INFO:
+		memset(&info, 0, sizeof(info));
+		info.version = PS2GS_VERSION;
+		info.max_buffer = PS2GS_MAX_BUFFER;
+		info.buffer = f->size;
+		info.vsync_irq = ps2gs.vsync_irq_ok;
+		return copy_to_user(uarg, &info, sizeof(info)) ? -EFAULT : 0;
+
+	case PS2GS_IOC_SEND:
+		if (copy_from_user(&s, uarg, sizeof(s)))
+			return -EFAULT;
+		return ps2gs_send(f, &s);
+
+	case PS2GS_IOC_WAIT:
+		return ps2gs_wait(arg);
+
+	case PS2GS_IOC_VSYNC:
+		return ps2gs_vsync_wait();
+
+	case PS2GS_IOC_GET_REG:
+		if (copy_from_user(&r, uarg, sizeof(r)))
+			return -EFAULT;
+		err = ps2gs_get_reg(r.reg, &r.value);
+		if (err)
+			return err;
+		return copy_to_user(uarg, &r, sizeof(r)) ? -EFAULT : 0;
+
+	case PS2GS_IOC_SET_REG:
+		if (copy_from_user(&r, uarg, sizeof(r)))
+			return -EFAULT;
+		return ps2gs_set_reg(r.reg, r.value);
+
+	case PS2GS_IOC_RESET:
+		ps2gs_reset_all();
+		return 0;
+	}
+
+	return -ENOTTY;
+}
+
+static const struct file_operations ps2gs_fops = {
+	.owner		= THIS_MODULE,
+	.open		= ps2gs_open,
+	.release	= ps2gs_release,
+	.mmap		= ps2gs_mmap,
+	.unlocked_ioctl	= ps2gs_ioctl,
+	.compat_ioctl	= ps2gs_ioctl,
+	.llseek		= no_llseek,
+};
+
+static struct miscdevice ps2gs_miscdevice = {
+	.minor	= MISC_DYNAMIC_MINOR,
+	.name	= "ps2gs",
+	.fops	= &ps2gs_fops,
+	.mode	= 0666,
+};
+
+/* --- Module ----------------------------------------------------------- */
+
+static int __init ps2gs_init(void)
+{
+	int err;
+	int i;
+
+	mutex_init(&ps2gs.lock);
+	init_waitqueue_head(&ps2gs.wq);
+	atomic_set(&ps2gs.vsync_count, 0);
+	atomic_set(&ps2gs.users, 0);
+
+	for (i = 0; i < ARRAY_SIZE(ps2gs.channel); i++) {
+		struct ps2gs_channel *ch = &ps2gs.channel[i];
+
+		err = request_irq(ch->irq, ps2gs_dma_irq, 0, "ps2gs DMA", ch);
+		if (err) {
+			pr_err("ps2gs: cannot request %s DMA IRQ %u: %d\n",
+				ch->name, ch->irq, err);
+			goto err_dma;
+		}
+	}
+
+	err = request_irq(IRQ_GS_VSYNC, ps2gs_vsync_irq, 0, "ps2gs vsync",
+		&ps2gs);
+	if (err) {
+		pr_warn("ps2gs: no vertical sync IRQ (%d), polling the CSR\n",
+			err);
+		ps2gs.vsync_irq_ok = false;
+	} else {
+		ps2gs.vsync_irq_ok = true;
+	}
+
+	err = misc_register(&ps2gs_miscdevice);
+	if (err) {
+		pr_err("ps2gs: cannot register the device: %d\n", err);
+		goto err_misc;
+	}
+
+	pr_info("ps2gs: device ready, buffers up to %u KiB\n",
+		PS2GS_MAX_BUFFER / 1024);
+
+	return 0;
+
+err_misc:
+	if (ps2gs.vsync_irq_ok)
+		free_irq(IRQ_GS_VSYNC, &ps2gs);
+	i = ARRAY_SIZE(ps2gs.channel);
+err_dma:
+	while (i-- > 0)
+		free_irq(ps2gs.channel[i].irq, &ps2gs.channel[i]);
+	return err;
+}
+
+static void __exit ps2gs_exit(void)
+{
+	int i;
+
+	misc_deregister(&ps2gs_miscdevice);
+	if (ps2gs.vsync_irq_ok)
+		free_irq(IRQ_GS_VSYNC, &ps2gs);
+	for (i = 0; i < ARRAY_SIZE(ps2gs.channel); i++)
+		free_irq(ps2gs.channel[i].irq, &ps2gs.channel[i]);
+}
+
+module_init(ps2gs_init);
+module_exit(ps2gs_exit);
+
+MODULE_DESCRIPTION("PlayStation 2 Graphics Synthesizer device for programs");
+MODULE_LICENSE("GPL");
