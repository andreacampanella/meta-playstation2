diff --git a/block/partitions/Kconfig b/block/partitions/Kconfig
index 702689a62..58291b37e 100644
--- a/block/partitions/Kconfig
+++ b/block/partitions/Kconfig
@@ -262,6 +262,16 @@ config SYSV68_PARTITION
 	  sysv68).
 	  Otherwise, say N.
 
+config PS2_APA_PARTITION
+	bool "PlayStation 2 APA partition support" if PARTITION_ADVANCED
+	default y if SONY_PS2
+	help
+	  Say Y here to read the hard disk of the PlayStation 2 in the
+	  partition format of its system software (APA), which uLaunchELF
+	  and OPL also use. Each used APA partition becomes a Linux
+	  partition, without the 4 MiB at its start that holds the APA
+	  header. The APA name is the partition name (PARTNAME).
+
 config CMDLINE_PARTITION
 	bool "Command line partition support" if PARTITION_ADVANCED
 	select BLK_CMDLINE_PARSER
