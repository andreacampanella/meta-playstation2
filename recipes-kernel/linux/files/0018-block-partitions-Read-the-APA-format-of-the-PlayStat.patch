 int warn_no_part = 1; /*This is ugly: should make genhd removable media aware*/
 
@@ -70,6 +71,9 @@ static int (*check_part[])(struct parsed_partitions *) = {
 #ifdef CONFIG_CMDLINE_PARTITION
