From: Andrea Campanella <emuboy85@gmail.com>
Subject: [PATCH] ata: pata_ps2: Poll PIO commands and offer no TRIM

The interrupt line of the SPEED interface is not reliable on every
console: the disk reports "lost interrupt (Status 0x58)" with the data
ready, and the Ethernet driver of the same chip sees its interrupts
stop too. With ATA_FLAG_PIO_POLLING libata polls the PIO and the
non-data commands and needs no interrupt for them.

TRIM (DATA SET MANAGEMENT) is always a DMA command in libata, also for
a disk in PIO mode, so mkfs.ext4 on an SSD went down the DMA path that
dma=0 turns off (HSM violation, warning in pata_ps2_dma_request). Mark
the devices ATA_HORKAGE_NOTRIM when the DMA modes are off.

Upstream-Status: Inappropriate [PlayStation 2 port]

--- a/drivers/ata/pata_ps2.c
+++ b/drivers/ata/pata_ps2.c
@@ -299,6 +299,16 @@
 	ATA_PIO_SHT(DRV_NAME),
 };
 
+/*
+ * TRIM (DATA SET MANAGEMENT) is always a DMA command in libata, also for
+ * a disk in PIO mode. Without the DMA modes it must not be offered.
+ */
+static void pata_ps2_dev_config(struct ata_device *adev)
+{
+	if (!pata_ps2_dma)
+		adev->horkage |= ATA_HORKAGE_NOTRIM;
+}
+
 static struct ata_port_operations pata_ps2_port_ops = {
 	.inherits		= &ata_sff_port_ops,
 	.qc_prep		= ata_noop_qc_prep,
@@ -306,6 +316,7 @@
 	.cable_detect		= ata_cable_unknown,
 	.set_piomode		= pata_ps2_set_piomode,
 	.set_dmamode		= pata_ps2_set_dmamode,
+	.dev_config		= pata_ps2_dev_config,
 };
 
 static void pata_ps2_setup_port(struct ata_ioports *ioaddr,
@@ -409,6 +420,13 @@
 		ap->udma_mask  = ATA_UDMA4;	// FIXME: ATA_UDMA5?
 	}
 	ap->flags     |= ATA_FLAG_NO_ATAPI;
+	/*
+	 * The interrupt line of the interface is not reliable on every
+	 * console (the Ethernet driver of the same chip falls back to
+	 * polling too). PIO commands are polled, so they need no interrupt.
+	 */
+	if (!pata_ps2_dma)
+		ap->flags |= ATA_FLAG_PIO_POLLING;
 
 	pp->dev = &pdev->dev;
 	pp->ap = ap;
