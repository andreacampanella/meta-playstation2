From: Andrea Campanella <emuboy85@gmail.com>
Date: Sat, 17 Oct 2026 10:50:00 +0100
Subject: [PATCH] mips: setjmp with 32-bit FPU stores on the R5900

setjmp and longjmp keep the callee-saved FPU registers with the s.d and
l.d macros. GAS refuses them for the R5900, which has no sdc1 and ldc1.
Store and load the two halves of each pair with swc1 and lwc1. With
-msingle-float the odd registers are singles of their own, and $f20 to
$f31 are all callee-saved, so the pairs cover them.

Upstream-Status: Inappropriate [PlayStation 2 port]
---
 sysdeps/mips/__longjmp.c  | 15 +++++++++++++++
 sysdeps/mips/setjmp_aux.c | 15 +++++++++++++++
 2 files changed, 30 insertions(+)

diff --git a/sysdeps/mips/__longjmp.c b/sysdeps/mips/__longjmp.c
index 264bc40..fb12ea0 100644
--- a/sysdeps/mips/__longjmp.c
+++ b/sysdeps/mips/__longjmp.c
@@ -37,6 +37,19 @@ ____longjmp (__jmp_buf env_arg, int val_arg)
 #endif
 
 #ifdef __mips_hard_float
+# ifdef _MIPS_ARCH_R5900
+  /* No ldc1: the two singles of each pair.  */
+#  define LOAD_PAIR(lo, hi, i) \
+  asm volatile ("lwc1 $f" #lo ", %0\n\tlwc1 $f" #hi ", 4+%0" \
+		: : "m" (env[0].__fpregs[i]))
+  LOAD_PAIR (20, 21, 0);
+  LOAD_PAIR (22, 23, 1);
+  LOAD_PAIR (24, 25, 2);
+  LOAD_PAIR (26, 27, 3);
+  LOAD_PAIR (28, 29, 4);
+  LOAD_PAIR (30, 31, 5);
+#  undef LOAD_PAIR
+# else
   /* Pull back the floating point callee-saved registers.  */
   asm volatile ("l.d $f20, %0" : : "m" (env[0].__fpregs[0]));
   asm volatile ("l.d $f22, %0" : : "m" (env[0].__fpregs[1]));
@@ -44,6 +57,7 @@ ____longjmp (__jmp_buf env_arg, int val_arg)
   asm volatile ("l.d $f26, %0" : : "m" (env[0].__fpregs[3]));
   asm volatile ("l.d $f28, %0" : : "m" (env[0].__fpregs[4]));
   asm volatile ("l.d $f30, %0" : : "m" (env[0].__fpregs[5]));
+# endif
 #endif
 
   /* Get the GP. */
diff --git a/sysdeps/mips/setjmp_aux.c b/sysdeps/mips/setjmp_aux.c
index f7c53b7..f21a357 100644
--- a/sysdeps/mips/setjmp_aux.c
+++ b/sysdeps/mips/setjmp_aux.c
@@ -31,6 +31,19 @@ inhibit_stack_protector
 __sigsetjmp_aux (jmp_buf env, int savemask, int sp, int fp)
 {
 #ifdef __mips_hard_float
+# ifdef _MIPS_ARCH_R5900
+  /* No sdc1: the two singles of each pair.  */
+#  define STORE_PAIR(lo, hi, i) \
+  asm volatile ("swc1 $f" #lo ", %0\n\tswc1 $f" #hi ", 4+%0" \
+		: : "m" (env[0].__jmpbuf[0].__fpregs[i]))
+  STORE_PAIR (20, 21, 0);
+  STORE_PAIR (22, 23, 1);
+  STORE_PAIR (24, 25, 2);
+  STORE_PAIR (26, 27, 3);
+  STORE_PAIR (28, 29, 4);
+  STORE_PAIR (30, 31, 5);
+#  undef STORE_PAIR
+# else
   /* Store the floating point callee-saved registers...  */
   asm volatile ("s.d $f20, %0" : : "m" (env[0].__jmpbuf[0].__fpregs[0]));
   asm volatile ("s.d $f22, %0" : : "m" (env[0].__jmpbuf[0].__fpregs[1]));
@@ -38,6 +51,7 @@ __sigsetjmp_aux (jmp_buf env, int savemask, int sp, int fp)
   asm volatile ("s.d $f26, %0" : : "m" (env[0].__jmpbuf[0].__fpregs[3]));
   asm volatile ("s.d $f28, %0" : : "m" (env[0].__jmpbuf[0].__fpregs[4]));
   asm volatile ("s.d $f30, %0" : : "m" (env[0].__jmpbuf[0].__fpregs[5]));
+# endif
 #endif
 
   /* .. and the PC;  */
